"NSCameraUsageDescription" = "Been Here ವ್ಯೂಫೈಂಡರ್ ಮೇಲೆ ಹಳೆಯ ಫೋಟೋವನ್ನು ತೋರಿಸುತ್ತದೆ, ಇದರಿಂದ ವರ್ಷಗಳ ನಂತರ ನೀವು ಅದೇ ಚಿತ್ರವನ್ನು ಮತ್ತೆ ತೆಗೆಯಬಹುದು. ಆ ಫೋಟೋ ತೆಗೆಯುವಾಗ ಮಾತ್ರ ಕ್ಯಾಮೆರಾ ಬಳಸಲಾಗುತ್ತದೆ.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "ಹಿನ್ನೆಲೆ ಸ್ಥಳದೊಂದಿಗೆ, ನೀವು ವರ್ಷಗಳ ಹಿಂದೆ ಫೋಟೋ ತೆಗೆದ ಸ್ಥಳಕ್ಕೆ ತಲುಪಿದಾಗ Been Here ಗಮನಿಸಿ, ಆ್ಯಪ್ ತೆರೆಯದೆಯೇ ಒಮ್ಮೆ ಹೇಳುತ್ತದೆ. ನಿಮ್ಮ ಫೋನ್ ನೀವು ಹೋಗಿದ್ದ ಕೆಲವೇ ಸ್ಥಳಗಳನ್ನು ಗಮನಿಸುತ್ತದೆ ಮತ್ತು ನೀವು ಅವುಗಳಲ್ಲಿ ಒಂದನ್ನು ಪ್ರವೇಶಿಸಿದಾಗ ಮಾತ್ರ ಆ್ಯಪ್ ಅನ್ನು ಎಬ್ಬಿಸುತ್ತದೆ — ನಿಮ್ಮ ಸ್ಥಳದ ಬಗ್ಗೆ ಏನೂ ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ.";
"NSLocationWhenInUseUsageDescription" = "ನೀವು ಎಲ್ಲಿದ್ದೀರಿ ಎಂಬುದನ್ನು ನಿಮ್ಮ ಫೋಟೋಗಳನ್ನು ತೆಗೆದ ಸ್ಥಳಗಳೊಂದಿಗೆ Been Here ಹೋಲಿಸುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಈಗ ತಲುಪಿದ ಸ್ಥಳದ ನಿಮ್ಮದೇ ಚಿತ್ರಗಳನ್ನು ತೋರಿಸಬಹುದು. ನಿಮ್ಮ ಸ್ಥಳ ಈ ಸಾಧನದಲ್ಲೇ ಬಳಕೆಯಾಗುತ್ತದೆ ಮತ್ತು ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲ್ಪಡುವುದಿಲ್ಲ.";
"NSPhotoLibraryAddUsageDescription" = "Been Here ನಲ್ಲಿ ನೀವು ತೆಗೆದ ಫೋಟೋ ನಿಮ್ಮದೇ ಫೋಟೋ ಲೈಬ್ರರಿಯಲ್ಲಿ, ಅದು ಉತ್ತರಿಸುವ ಚಿತ್ರದ ಪಕ್ಕದಲ್ಲಿ ಉಳಿಸಲ್ಪಡುತ್ತದೆ.";
"NSPhotoLibraryUsageDescription" = "ನಿಮ್ಮ ಫೋಟೋಗಳನ್ನು ಎಲ್ಲಿ ಮತ್ತು ಯಾವಾಗ ತೆಗೆದಿದೆ ಎಂಬುದನ್ನು Been Here ಓದುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಒಂದು ಸ್ಥಳಕ್ಕೆ ಮರಳಿದಾಗ ಅಲ್ಲಿನ ನಿಮ್ಮದೇ ಚಿತ್ರಗಳನ್ನು ತೋರಿಸಬಹುದು. ನಿಮ್ಮ ಫೋಟೋಗಳು ಮತ್ತು ಅವುಗಳ ಸ್ಥಳಗಳು ಈ ಸಾಧನದಲ್ಲೇ ಉಳಿಯುತ್ತವೆ.";
