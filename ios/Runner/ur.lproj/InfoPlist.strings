"NSCameraUsageDescription" = "Been Here ویو فائنڈر کے اوپر ایک پرانی تصویر دکھاتا ہے تاکہ آپ برسوں بعد وہی شاٹ دوبارہ لے سکیں۔ کیمرا صرف اس تصویر کو کھینچتے وقت استعمال ہوتا ہے۔";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "بیک گراؤنڈ لوکیشن کے ساتھ، جب آپ کسی ایسی جگہ پہنچتے ہیں جہاں آپ نے برسوں پہلے تصویر کھینچی تھی تو Been Here اسے بھانپ لیتا ہے اور ایپ کھولے بغیر ایک بار بتا دیتا ہے۔ آپ کا فون آپ کی دیکھی ہوئی چند جگہوں پر نظر رکھتا ہے اور صرف اسی وقت ایپ کو جگاتا ہے جب آپ ان میں سے کسی میں داخل ہوں — آپ کی لوکیشن کے بارے میں کچھ بھی کہیں نہیں بھیجا جاتا۔";
"NSLocationWhenInUseUsageDescription" = "Been Here آپ کی موجودہ جگہ کا موازنہ ان جگہوں سے کرتا ہے جہاں آپ کی تصاویر کھینچی گئیں، تاکہ آپ جس جگہ ابھی پہنچے ہیں وہاں کی آپ کی اپنی تصاویر دکھا سکے۔ آپ کی لوکیشن اسی ڈیوائس پر استعمال ہوتی ہے اور کہیں نہیں بھیجی جاتی۔";
"NSPhotoLibraryAddUsageDescription" = "Been Here میں آپ کی کھینچی ہوئی تصویر آپ کی اپنی فوٹو لائبریری میں، اس تصویر کے ساتھ محفوظ ہوتی ہے جس کے جواب میں وہ لی گئی۔";
"NSPhotoLibraryUsageDescription" = "Been Here یہ پڑھتا ہے کہ آپ کی تصاویر کہاں اور کب کھینچی گئیں، تاکہ جب آپ کسی جگہ واپس آئیں تو وہاں کی آپ کی اپنی تصاویر دکھا سکے۔ آپ کی تصاویر اور ان کی لوکیشن اسی ڈیوائس پر رہتی ہیں۔";
