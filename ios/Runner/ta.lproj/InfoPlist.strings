"NSCameraUsageDescription" = "Been Here வியூஃபைண்டருக்கு மேலே ஒரு பழைய புகைப்படத்தைக் காட்டுகிறது, வருடங்கள் கழித்து நீங்கள் அதே காட்சியை மீண்டும் எடுக்கலாம். அந்தப் புகைப்படம் எடுக்கும்போது மட்டுமே கேமரா பயன்படுத்தப்படுகிறது.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "பின்னணி இருப்பிடம் இருந்தால், நீங்கள் வருடங்களுக்கு முன் புகைப்படம் எடுத்த இடத்துக்கு வரும்போது Been Here அதை உணர்ந்து, ஆப்ஸைத் திறக்காமலே ஒருமுறை சொல்லும். நீங்கள் சென்ற சில இடங்களை மட்டும் உங்கள் தொலைபேசி கவனிக்கிறது, அவற்றில் ஒன்றுக்குள் நுழையும்போது மட்டுமே ஆப்ஸை எழுப்புகிறது — உங்கள் இருப்பிடம் பற்றி எதுவும் எங்கும் அனுப்பப்படாது.";
"NSLocationWhenInUseUsageDescription" = "நீங்கள் எங்கே இருக்கிறீர்கள் என்பதை உங்கள் புகைப்படங்கள் எடுக்கப்பட்ட இடங்களுடன் Been Here ஒப்பிடுகிறது, நீங்கள் இப்போது வந்த இடத்தின் உங்கள் சொந்தப் படங்களைக் காட்ட. உங்கள் இருப்பிடம் இந்தச் சாதனத்திலேயே பயன்படுத்தப்படுகிறது, எங்கும் அனுப்பப்படாது.";
"NSPhotoLibraryAddUsageDescription" = "Been Here இல் நீங்கள் எடுக்கும் புகைப்படம் உங்கள் சொந்த புகைப்பட நூலகத்தில், அது பதிலளிக்கும் படத்தின் அருகே சேமிக்கப்படுகிறது.";
"NSPhotoLibraryUsageDescription" = "உங்கள் புகைப்படங்கள் எங்கே, எப்போது எடுக்கப்பட்டன என்பதை Been Here படிக்கிறது, நீங்கள் ஒரு இடத்துக்குத் திரும்பும்போது அங்குள்ள உங்கள் சொந்தப் படங்களைக் காட்ட. உங்கள் புகைப்படங்களும் அவற்றின் இருப்பிடங்களும் இந்தச் சாதனத்திலேயே இருக்கும்.";
